# Optional. Defaults also work for a local-only demo; never use them in production.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
LAKE_BUCKET=taxi-datalake
# Valeurs PAR DEFAUT du formulaire Airflow ; modifiables lors de chaque Trigger.
# Pour scripts hors Airflow, elles restent les dates effectives.
START_DATE=2023-01-01
END_DATE=2023-01-08
PAGE_SIZE=20000
MAX_ROWS=150000
# Quality gates: fractions of fetched raw rows, not full historical coverage.
MAX_REJECT_RATE=0.10
MAX_DUPLICATE_RATE=0.10
# Freshness refers to API extraction timestamp, not 2023 trip dates.
MAX_EXTRACT_AGE_HOURS=24
MAX_TRIP_MILES=500
MAX_TRIP_DURATION_SECONDS=86400
MAX_TRIP_TOTAL_USD=5000
# Optional: https://data.cityofchicago.org/profile/edit/developer_settings
SODA_APP_TOKEN=
SPARK_DRIVER_MEMORY=2g
# Shared secrets for the API server and the scheduler (randomize if sharing).
AIRFLOW_API_SECRET_KEY=local-demo-api-secret-change-before-sharing-123456789
AIRFLOW_JWT_SECRET=local-demo-jwt-secret-change-before-sharing-123456789
